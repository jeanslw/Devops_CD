# ============================================================================
# CD 业务参数（Application config / 应用行为参数）
# ============================================================================
# 本文件只放「跟部署环境无关」的应用行为参数；它随镜像/仓库发布，容器里改完重启即可。
#   Application behaviour parameters only — shipped with the image/repo, restart to apply.
#
# 不放的东西（这些属于部署层，写在项目根 .env）：
#   Not here — deployment values live in the repo-root .env:
#   数据库连接 DB_DRIVER / DB_PATH / DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASS、
#   SECRET_KEY、HARBOR_BASE_URL / HARBOR_USER / HARBOR_PASSWORD、
#   CI_API_URL / CI_API_TOKEN / CI_ADMIN_USER / CI_ADMIN_PASS、DINGTALK_SECRET、
#   HOST / PORT / TZ / TRUSTED_PROXY_HOPS
#
# 优先级 / Precedence：进程环境变量 > 根 .env > 本文件 > 代码默认值
#   即：部署时想临时覆盖某项（例如容器里把 SSH_TIMEOUT 调大），写进根 .env 或 compose 的
#   environment 即可生效，无需重建镜像；本文件只是随版本发布的默认值。
#   To override temporarily (e.g. raise SSH_TIMEOUT in Docker) put it in the root .env or the
#   compose `environment:` block — root .env wins over this file, no image rebuild needed.
#
# ============================================================================

# ── 登录 token（小时）/ Login token TTL in hours ──
# 过期后需重新登录。token 为服务端会话（cd_sessions 表存 SHA-256 摘要），
# 退出登录（/api/logout）删行即时吊销，无需等到期。
AUTH_TOKEN_TTL_HOURS=24

# HttpOnly 会话 cookie 是否加 Secure（仅 HTTPS 下浏览器才回传 cookie）。
# 服务在 nginx 之后以 HTTPS 对外时应设 true；直连 HTTP 暴露时保持 false。
COOKIE_SECURE=false

# ── systems 空值访问策略 / empty-systems access policy ──
# admin_users.systems 为空时是否放行 CD 访问。true（默认）兼容历史数据；
# 严格环境可设 false（deny-by-default，空 systems 即无 CD 权限）。
ALLOW_EMPTY_SYSTEMS=true

# ── 角色 / Role ──
# 超级管理员角色名（隐含全部权限）；具体权限以 roles / permissions / role_permissions 表为准。
SUPER_ADMIN_ROLE=super_admin

# ── 认证模式 / Authentication mode（SSO OIDC，见 docs/SSO_OIDC_ZH.md）──
# oidc（默认，即默认登录方式）= Devops-Glue 单点登录：身份与权限经 Glue HTTP API 获取，
#     请求路径上不读共享表；
# local = 本地密码登录 + 每请求直读共享表（admin_users / roles / role_permissions）。
# 唯一总开关：切档 = 改这一行 + 重启；回退 = 改回 local + 重启（零 DDL，CD 数据无损）。
# oidc 必填项：OIDC_ISSUER（本文件，部署时按环境在根 .env 覆盖）
#             + CD_OIDC_SECRET / CD_OIDC_REDIRECT_URI（根 .env）。
# 缺失时：compose 的 env-check 中止启动，裸机启动日志记 ERROR，登录页点 SSO 会提示缺少的项目。
AUTH_MODE=oidc

# Glue 对外地址；必须与其 discovery（/.well-known/openid-configuration）的 issuer 完全一致。
# 留空表示未配置（本文件只放与环境无关的默认值，实际地址在根 .env 按环境填写）。
# 写成内网 / 错误地址会导致登录失败，日志会同时打印 discovery 的 issuer 与期望值。
OIDC_ISSUER=

# 惰性复核窗口（秒）：已登录会话距上次 Glue 复核超过该值才重新查询一次，
# 即停用 / 降权的生效上限（默认 60s），不必等会话 TTL。
OIDC_REVALIDATE_SECONDS=60

# Glue 不可达时的软失败窗口（秒）：窗口内沿用 last-known-good 身份放行，超过即 fail-closed（503）；
# 0 = 立即 fail-closed（完全不忍受短暂不可用）。
OIDC_STALE_GRACE_SECONDS=600

# id_token 的 iat / exp 时钟偏移容忍（秒）：双方机器时钟有微差时放宽校验。
OIDC_ID_TOKEN_MAX_SKEW=60

# 登录 scope：必须含 openid，否则响应不带 id_token（拿不到身份，且 Glue 不会报错）。
OIDC_SCOPES=openid profile email

# ── 连接池（MySQL 模式）/ MySQL connection pool ──
DB_POOL_MAX=10
DB_POOL_MIN=2

# ── SSH ──
SSH_TIMEOUT=30
SSH_KEEPALIVE=30                         # 0 关闭 keepalive / 0 disables keepalive
SSH_AUTO_TRUST=false                     # 已废弃，仅为兼容旧配置保留；代码始终 RejectPolicy + known_hosts
                                         # Deprecated: kept for old configs; code always uses RejectPolicy + known_hosts

# ── Docker 部署 / Docker deployment ──
CONTAINER_RESTART_POLICY=always          # 部署容器时写入的 restart 策略 / restart policy written on deploy

# ── K8s 部署 / K8s deployment ──
FLUX_NAMESPACE=flux-system
K8S_HELM_TIMEOUT=300                     # helm upgrade --install --timeout（秒 / seconds）
K8S_ROLLOUT_TIMEOUT=120                  # kubectl rollout status --timeout（秒 / seconds）
# ArgoCD API 是否校验 TLS（ArgoCD 始终 HTTPS；自签名证书环境保持 false，证书受信环境设 true 防中间人截获 token）
ARGOCD_VERIFY_TLS=false

# ── 通知 / Notification ──
LOG_TRUNCATE_CHARS=20000                 # 日志截断字符数 / log truncation (characters)
NOTIFY_TRUNCATE_CHARS=200                # 通知正文截断字符数 / notification body truncation

# ── 镜像仓库定时同步 / Registry periodic sync ──
REGISTRY_SYNC_INTERVAL=30                # 分钟，0 = 关闭 / minutes, 0 disables

# ── CI 集成 / CI integration ──
CI_TIMEOUT=30                            # 调用 Devops-Glue API 的超时（秒）/ API timeout (seconds)

# ── 监控与告警 / Monitoring & alerting ──
MONITORING_ENABLED=true
MONITOR_CACHE_SERVERS=60                 # 以下均为缓存 TTL（秒）/ cache TTLs in seconds
MONITOR_CACHE_SYSTEM=30
MONITOR_CACHE_NODES=30
MONITOR_CACHE_PODS=30
MONITOR_CACHE_DOCKER=30
MONITOR_CACHE_POD_DETAIL=15
ALERT_CHECK_INTERVAL=60                  # 告警检测间隔（秒）/ alert check interval (seconds)
