# CD Service Configuration (CD 服务配置)
# Copy to .env and modify the values below (复制为 .env 并修改以下值)

# ── Database (数据库，推荐 MySQL / MariaDB，与 Devops-Glue 共享同一库) ──
# MySQL / MariaDB mode: fill in the 5 fields below (MySQL 模式：填写以下 5 项)
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=YOUR_MYSQL_USER
DB_PASS=YOUR_MYSQL_PASSWORD

# Encryption / signing key (加密/签名密钥，可选 — 留空则自动生成 .cd_secret_key 文件)
# ⚠️ Production: leave empty (auto random key) or set a 32+ char random string (生产环境留空自动生成随机密钥，或填 32+ 位随机字符串，如 openssl rand -base64 32)。
#    Never use sample/default values: it encrypts SSH passwords & keys in cd_servers (禁止使用任何示例值/默认值：它用于加密 cd_servers 中的 SSH 口令与私钥)。
SECRET_KEY=

# Timezone (时区，docker-compose 默认 Asia/Shanghai)。定时发布/审批单时间基于服务器本地时间，
# must match users' timezone or scheduled deploys fire at wrong time (必须与用户所在时区一致，否则定时发布会在错误时间执行)。留空 = 容器默认 UTC。
TZ=Asia/Shanghai

# Login token TTL in hours (登录 token 有效期，小时，默认 24)。过期后需重新登录；旧格式 token 仍兼容。
# AUTH_TOKEN_TTL_HOURS=24

# ArgoCD API TLS verification (ArgoCD API 是否校验 TLS 证书，默认 false，兼容自签名证书)。
# ArgoCD is always HTTPS; set true when cert is trusted (ArgoCD 始终走 HTTPS；证书受信环境设 true 防中间人截获 Bearer token)。
# ARGOCD_VERIFY_TLS=false

# Trusted reverse-proxy hops (反向代理可信跳数，默认 0)。服务直接暴露时保持 0；
# set 1 behind nginx (位于 nginx 等反向代理之后时设为 1，多层代理按层数增加)，用于登录失败锁定取真实客户端 IP。
# TRUSTED_PROXY_HOPS=1

# SQLite mode (SQLite 模式，可选)：comment out MySQL config above, uncomment the 2 lines below (注释上方 MySQL 配置，启用以下 2 行)
# DB_DRIVER=sqlite
# DB_PATH=../Devops-Glue/config/data/data.db

# ═══════════════════════════════════════
# Required — Harbor Image Registry (必填 — Harbor 镜像仓库)
# ═══════════════════════════════════════
HARBOR_BASE_URL=http://your_harbor_address
HARBOR_USER=your_harbor_user
HARBOR_PASSWORD=your_harbor_password


# ═══════════════════════════════════════
# Optional — CI integration (可选 — CI 集成，Devops-Glue API，启用构建管理)
# ═══════════════════════════════════════
# CI_API_URL=http://localhost:8080
# CI_API_TOKEN=dg_xxx     # API token (API token，dg_ 前缀) — preferred (推荐)

# ═══════════════════════════════════════
# Optional — Registry periodic sync (可选 — 镜像仓库定时同步，默认 30 分钟，0 为禁用)
# ═══════════════════════════════════════
# REGISTRY_SYNC_INTERVAL=30

# ═══════════════════════════════════════
# Optional — sensible defaults below, usually no need to change (可选 — 以下默认值合理，通常无需修改)
# ═══════════════════════════════════════
# HOST=0.0.0.0
# PORT=8081
# SSH_TIMEOUT=30
# CONTAINER_RESTART_POLICY=always
# FLUX_NAMESPACE=flux-system
# LOG_TRUNCATE_CHARS=2000
# NOTIFY_TRUNCATE_CHARS=200
# DINGTALK_SECRET=YOUR_DINGTALK_SECRET
# MONITORING_ENABLED=true
# MONITOR_CACHE_SERVERS=60
# MONITOR_CACHE_SYSTEM=30
# MONITOR_CACHE_NODES=30
# MONITOR_CACHE_PODS=30
# MONITOR_CACHE_DOCKER=30
# MONITOR_CACHE_POD_DETAIL=15
# ALERT_CHECK_INTERVAL=60

