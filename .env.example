# CD Service 部署配置:复制为 .env,只放随部署环境变化的变量.
# 业务参数(超时 / 缓存 TTL / 间隔)在 config/app.env;优先级:进程环境变量 > 本文件 > config/app.env > 代码默认值.
# 与 Devops-Glue 联合部署(共用 Glue 根 .env)时:DB_* / HARBOR_* / SECRET_KEY / CI_API_TOKEN /
# CD_API_TOKEN / TZ 直接沿用;OIDC_* 三项为 CD 专属,需补进同一份 .env.详见 docs/ADMIN_MANUAL_ZH.md §2.3.

# ── 数据库(必填)────────────────────────────────────
# 共库:DB_NAME 填 Glue 的库名(如 devops_glue);拆库:填 CD 专用库名(如 devops_cd).
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_cd
DB_USER=YOUR_MYSQL_USER
DB_PASS=YOUR_MYSQL_PASSWORD
# SQLite 模式:注释上方 6 行,启用以下 2 行;DB_PATH 须为容器路径(挂载 /data 卷,见 docker-compose.yml).
# DB_DRIVER=sqlite
# DB_PATH=/data/data.db

# ── 加密密钥(容器必填)──────────────────────────────
# 加密 cd_servers 中的 SSH 口令/私钥;生成:openssl rand -base64 32.
# 容器文件系统只读,留空或用公开示例值都会被 env-check 中止;裸机可留空(首次运行自动生成 .cd_secret_key).
SECRET_KEY=

# ── OIDC 单点登录(必填,唯一登录方式)────────────────
# 缺任一项:compose 预检中止启动 / 裸机启动记 ERROR / 登录页提示缺哪些.
OIDC_ISSUER=                 # Glue 对外地址,须与 discovery 的 issuer 完全一致
CD_OIDC_SECRET=              # 与 Glue oauth_clients['cd']['secret'] 一致
CD_OIDC_REDIRECT_URI=         # 与 Glue 登记值逐字符一致(含 scheme/host/port/path)

# ── Glue API(必填:身份 / 权限 / 契约闸门全走 Glue API)──
CI_API_URL=http://localhost:8080   # Glue API 地址
CI_API_TOKEN=dg_xxx                # 服务 token(dg_ 前缀),登录必需
# CD_API_TOKEN=                    # CI→CD 入站 token:Glue 拉取 /api/integration/deploy-logs 时携带,
#                                  # 两侧须同值;留空则该端点拒绝所有请求

# ── Harbor 镜像仓库(必填)───────────────────────────
HARBOR_BASE_URL=http://your_harbor_address
HARBOR_USER=your_harbor_user
HARBOR_PASSWORD=your_harbor_password
# HARBOR_VERIFY_SSL=false          # Harbor 自签名证书时关闭校验

# ── 可选 ──────────────────────────────────────────
TZ=Asia/Shanghai              # 定时发布 / 审批单按此时区执行;留空 = 容器默认 UTC
# HOST=0.0.0.0                # 监听地址(compose 已注入)
# PORT=8081
# TRUSTED_PROXY_HOPS=1       # 已无消费者,仅为兼容旧配置保留
# DINGTALK_SECRET=           # 钉钉加签密钥



