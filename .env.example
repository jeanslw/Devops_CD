# CD Service Configuration
# Copy to .env and modify the values below

# ── Database (MySQL / MariaDB recommended, shares devops_glue with PHP side) ──
# MySQL / MariaDB mode: fill in the 5 fields below
DB_DRIVER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_NAME=devops_glue
DB_USER=YOUR_MYSQL_USER
DB_PASS=YOUR_MYSQL_PASSWORD

# Encryption / signing key (optional — auto-generates .cd_secret_key file if empty)
# ⚠️ 生产环境务必留空（自动生成随机密钥）或填入 32+ 字符的随机字符串（如 openssl rand -base64 32）。
#    禁止使用任何示例值/默认值：它用于加密 cd_servers 中的 SSH 口令与私钥。
SECRET_KEY=

# 反向代理可信跳数（默认 0）。服务直接暴露时保持 0；
# 位于 nginx 等反向代理之后时设为 1（多层代理按层数增加），用于登录失败锁定取真实客户端 IP。
# TRUSTED_PROXY_HOPS=1

# SQLite mode (optional): comment out MySQL config above, uncomment the 2 lines below
# DB_DRIVER=sqlite
# DB_PATH=../Devops-Glue/config/data/data.db

# ═══════════════════════════════════════
# Required — Harbor Image Registry
# ═══════════════════════════════════════
HARBOR_BASE_URL=http://your_harbor_address
HARBOR_USER=your_harbor_user
HARBOR_PASSWORD=your_harbor_password


# ═══════════════════════════════════════
# Optional — CI integration (Devops-Glue API, enables build management)
# ═══════════════════════════════════════
# CI_API_URL=http://localhost:8080
# CI_API_TOKEN=dg_xxx     # API token (dg_ prefix) — preferred

# ═══════════════════════════════════════
# Optional — Registry periodic sync (default 30 min, 0 to disable)
# ═══════════════════════════════════════
# REGISTRY_SYNC_INTERVAL=30

# ═══════════════════════════════════════
# Optional — sensible defaults below, usually no need to change
# ═══════════════════════════════════════
# HOST=0.0.0.0
# PORT=8081
# SSH_TIMEOUT=30
# CONTAINER_RESTART_POLICY=always
# FLUX_NAMESPACE=flux-system
# LOG_TRUNCATE_CHARS=2000
# NOTIFY_TRUNCATE_CHARS=200
# DINGTALK_SECRET=YOUR_DINGTALK_SECRET
# MONITORING_ENABLED=true
# MONITOR_CACHE_SERVERS=60
# MONITOR_CACHE_SYSTEM=30
# MONITOR_CACHE_NODES=30
# MONITOR_CACHE_PODS=30
# MONITOR_CACHE_DOCKER=30
# MONITOR_CACHE_POD_DETAIL=15
# ALERT_CHECK_INTERVAL=60
